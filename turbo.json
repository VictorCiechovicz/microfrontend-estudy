{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "persistent": true, "cache": false },
    "start": { "persistent": true, "cache": false },
    "build": {
      "dependsOn": ["^build"],
      "env": ["EXPOSE_TESTING_API"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
